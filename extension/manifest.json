{
  "manifest_version": 2,
  "name": "随机训练题高亮",
  "version": "1.0.0",
  "description": "随机选择指向 /problemset/problem/xxx 或运行 pm1 JS 函数的链接，并用黄色标记",
  "icons": {
    "48": "icons/icon-48.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "重新随机选择一道训练题",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "random-training-questions@voidcat.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
